# Claude Code Ignore File
# Files and directories listed here will be excluded from Claude's default context
# Claude can still access these files if explicitly referenced or searched

# Human documentation (not needed for daily coding)
docs/
README.md

# Build artifacts and dependencies
node_modules/
.next/
dist/
build/
out/
.turbo/

# Environment and secrets
.env
.env.*
!.env.example

# Git
.git/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# Vercel
.vercel/

# Prisma
prisma/migrations/

# Playwright
test-results/
playwright-report/
playwright/.cache/
