{
  "env": {
    "PROJECT_ROOT": "/absolute/path/to/honkadori",
    "GITHUB_PERSONAL_ACCESS_TOKEN": "github_pat_your-token-here",
    "LINEAR_API_KEY": "lin_api_your-key-here"
  },
  "permissions": {
    "allow": [
      "Bash(gh api:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh workflow run:*)",
      "Bash(git checkout:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm type-check:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm db:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm playwright:*)",
      "mcp__better-auth__search",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "mcp__next-devtools__nextjs_runtime",
      "mcp__next-devtools__browser_eval",
      "mcp__playwright__browser_navigate",
      "mcp__linear-server__*",
      "WebSearch",
      "WebFetch(domain:github.com)"
    ],
    "deny": [],
    "ask": []
  }
}
