// Prisma schema for Better Auth with Neon PostgreSQL
// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum DietaryType {
  vegetarian
  vegan
  pescatarian
}

enum MealImageStatus {
  none
  generating
  ready
  failed
}

enum MealType {
  breakfast
  lunch
  dinner
}

enum MealPlanEntryStatus {
  planned
  completed
  skipped
}

/// What a planned entry is (HON-1277). `meal` points to a recipe through
/// `mealId`, or is a picker placeholder or a note-only card while `mealId` is
/// null. `fridge` is a fridge meal: no recipe, a list of `items` instead.
enum MealPlanEntryKind {
  meal
  fridge
}

enum EntryRating {
  up
  down
}

enum Unit {
  g
  piece
}

/// Where a gram-stored ingredient shows as pieces (HON-1312). Display only:
/// the stored quantity stays in grams.
enum PieceDisplay {
  none
  recipe
  recipe_and_shopping
}

enum IngredientCategory {
  protein
  carb
  vegetable
  fruit
  dairy
  fat
  legume
  condiment
  spice
}

enum HouseholdRole {
  owner
  member
}

enum Allergen {
  gluten
  dairy
  eggs
  nuts
  peanuts
  soy
  fish
  shellfish
  sesame
}

enum ProteinType {
  poultry
  beef
  pork
  lamb
  fish
  eggs
  legume
  dairy
  none
}

enum AiFeature {
  plan_generate
  plan_fill_empty
  meal_imagine
  meal_review_quantities
  recipe_parse
  entry_suggestions
  entry_preparation_tips
  entry_regenerate
  meal_image
  cook_question
  adjust_recipe
}

// ============================================
// BETTER AUTH MODELS
// ============================================

// Better Auth models
// Generated with: npx @better-auth/cli generate
// Now managed manually in this schema file
// Run the generate command again if adding Better Auth plugins that require new tables

model User {
  id                   String              @id
  name                 String
  email                String
  emailVerified        Boolean             @default(false)
  image                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now()) @updatedAt
  // GDPR Art. 17 soft-delete (HON-481). `deletedAt` non-null means the user
  // requested deletion; sign-in is blocked while set. `purgeScheduledFor` is
  // when the daily cron hard-cascades the account — the first 03:00 UTC cron
  // run at/after request time + 30 days (see computePurgeInstant in src/lib/auth/account.ts).
  deletedAt            DateTime?
  purgeScheduledFor    DateTime?
  // Versioned Terms/Privacy consent captured at sign-up (HON-457). Stamped
  // server-side in `databaseHooks.user.create.before` (src/lib/auth.ts) —
  // never client-supplied. Version mirrors CURRENT_TERMS_VERSION
  // (src/lib/consent.ts); nullable so pre-policy users remain valid rows.
  acceptedTermsAt      DateTime?
  acceptedTermsVersion Int?
  sessions             Session[]
  accounts             Account[]
  // Singular: `HouseholdMember.userId` is unique — one household per user (HON-696).
  householdMembership  HouseholdMember?
  signupCodesCreated   SignupCode[]        @relation("SignupCodeCreatedBy")
  signupCodeUsed       SignupCode?         @relation("SignupCodeUsedBy")
  // OAuth provider for MCP clients (HON-1150). Tokens and consents cascade, so
  // account deletion removes every grant; a registered client survives with
  // `userId` cleared, because it is the client's record, not the user's.
  oauthClients         OauthClient[]
  oauthAccessTokens    OauthAccessToken[]
  oauthRefreshTokens   OauthRefreshToken[]
  oauthConsents        OauthConsent[]
  // Read-only keys for screens and scripts (HON-1220). Cascade, and the
  // soft-delete in `DELETE /api/auth/user` deletes them at once.
  apiKeys              ApiKey[]

  @@unique([email])
  @@index([purgeScheduledFor])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  // Better Auth 1.7.0–1.7.2 made `issuer` the identity key for an account.
  // 1.7.3 went back to `(providerId, accountId)` and no longer writes this
  // column, so the default fills it on every insert, Google accounts
  // (HON-1157) included: the value says nothing about the provider, which is
  // `providerId`. With one constant issuer the unique key is `accountId` alone;
  // a Google subject (21 digits) never equals a user id. Dropping
  // the column is optional cleanup (Better Auth 1.7 upgrade guide → "Account
  // identity keeps the provider key"); it is kept so a migration never has to
  // race a deploy still running 1.7.2 (HON-1150).
  issuer                String    @default("local:credential")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// OAuth 2.1 authorization server for MCP clients (HON-1150). Written by hand
// from the `jwt` plugin schema (better-auth/dist/plugins/jwt/schema.mjs) and
// the `@better-auth/oauth-provider` schema that `@better-auth/mcp` uses; there
// is no Better Auth CLI here (docs/SECURITY.md → Better Auth schema changes). Better Auth checks
// these at init and rejects auth requests on a missing table or column, so a
// plugin upgrade that adds a field needs a migration first. Model names are
// `Oauth…` so the Prisma client property is `oauthClient`, the name the
// adapter asks for. Fields Better Auth marks `required` are non-null; the rest
// are optional, as its generator writes them.

// Signing keys for access and ID tokens, served at `/api/auth/jwks`. The
// private key is encrypted with BETTER_AUTH_SECRET.
model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

// A registered OAuth client: dynamic registration (RFC 7591) or a Client ID
// Metadata Document (`clientDiscoveryId` set).
model OauthClient {
  id                               String    @id
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  user                             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  resources     OauthClientResource[]
  accessTokens  OauthAccessToken[]
  refreshTokens OauthRefreshToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@map("oauth_client")
}

// A protected resource the server issues tokens for. `mcp()` seeds the MCP
// resource (`<origin>/api/mcp`) at init.
model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clients OauthClientResource[]

  @@map("oauth_resource")
}

// Which client may request which resource.
model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauth_client_resource")
}

// A refresh token, issued with `offline_access`. Stored hashed.
model OauthRefreshToken {
  id                      String      @id
  token                   String      @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_token")
}

// An opaque access token. Tokens bound to the MCP resource are JWTs and are
// not stored; this table holds only the ones without a resource audience.
model OauthAccessToken {
  id                      String             @id
  token                   String?            @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_token")
}

// A user's consent to a client for a set of scopes. `/consent` writes it; a
// later authorization with the same scopes skips the consent page.
model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?
  updatedAt               DateTime?

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

// A read-only API key for a screen or script (HON-1220), made on `/account/connections`.
// Only the SHA-256 hash of the key is stored, plus its first characters for
// the list. `GET /api/v1/*` looks the key up by `hash`; see src/lib/api-keys.ts.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  start      String
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  /// Null for a key that does not expire. A key past it answers 401 (HON-1221).
  expiresAt  DateTime?

  @@index([userId])
  @@map("api_key")
}

// Replay guard for `private_key_jwt` client assertions: the id is a digest of
// the assertion's `jti`.
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauth_client_assertion")
}

// Single-use sign-up codes that gate `/sign-up` while the launch is invite-only.
// Atomic claim relies on the unique index on `code` plus a row-level UPDATE
// predicate (see src/lib/signup-codes.ts). `usedById` is unique so a code can
// link to at most one user.
model SignupCode {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  usedById    String?   @unique
  usedAt      DateTime?
  expiresAt   DateTime?
  note        String?

  createdBy       User?            @relation("SignupCodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usedBy          User?            @relation("SignupCodeUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  waitlistRequest WaitlistRequest?

  @@index([createdById])
  @@map("signup_code")
}

/// A visitor without an invite code asking for one (HON-846). Consent-based
/// (GDPR Art. 6(1)(a)) with double opt-in: the row counts only once
/// `confirmedAt` is set from the emailed link. Retention is enforced by
/// `/api/cron/purge-deleted-users`: unconfirmed rows go 7 days after
/// `createdAt`, confirmed rows 6 months after `confirmedAt`.
model WaitlistRequest {
  id           String    @id @default(cuid())
  /// Trimmed and lowercased before it is stored.
  email        String    @unique
  /// The page locale when the request was made; the invite email uses it.
  locale       String
  /// `nanoid(32)` from the confirmation email. Kept after confirmation, so a
  /// second open of the link (a mail scanner opened it first) still works;
  /// replaced on a resubmit and dead 7 days after `createdAt`.
  confirmToken String?   @unique
  /// Reset whenever a token is reissued, so the 7-day link window and the
  /// unconfirmed purge both count from the latest email.
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime?
  /// Written by the admin invite flow (HON-970).
  invitedAt    DateTime?
  /// The code sent to this address (HON-970).
  signupCodeId String?   @unique
  /// The `ref` of the link the person followed to `/request-invite`, when it
  /// matched `WAITLIST_REF_PATTERN` (HON-1089). Set when the row is created and
  /// never updated, so the first source wins.
  source       String?

  signupCode SignupCode? @relation(fields: [signupCodeId], references: [id], onDelete: SetNull)

  @@map("waitlist_request")
}

// ============================================
// MULTI-TENANCY & HOUSEHOLDS
// ============================================

model Household {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Europe/Tallinn")
  locale    String   @default("en")
  aiCapUsd  Decimal  @default(5.00) @db.Decimal(10, 4)
  createdAt DateTime @default(now())

  members             HouseholdMember[]
  preferences         HouseholdPreferences?
  mealPlans           MealPlan[]
  meals               Meal[]
  pantryItems         PantryItem[]
  invites             HouseholdInvite[]
  favoriteMeals       FavoriteMeal[]
  customShoppingItems CustomShoppingItem[]
  aiUsage             AiUsage[]
  ingredients         Ingredient[]
  dayExtras           DayExtra[]

  @@map("household")
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  // Unique: a user belongs to at most one household (HON-696). Nullable, and
  // PostgreSQL's default NULLS DISTINCT lets any number of manual members
  // (no linked user) coexist.
  userId      String?       @unique
  name        String?
  role        HouseholdRole @default(member)
  joinedAt    DateTime      @default(now())

  // Weekly planning reminder email (HON-1084). Consent is the recipient's, so
  // it lives on the member, and a member with no `userId` can never opt in.
  /// ISO weekday the reminder goes out on: 1 is Monday, 7 is Sunday. Null is off.
  reminderWeekday      Int?
  /// When the member switched the reminder on. Cleared when it is switched off.
  reminderConsentAt    DateTime?
  /// `nanoid(32)` for the stop link, minted on the first opt-in and kept after opt-out,
  /// so the stop link in an older email still works after a later opt-in.
  reminderToken        String?   @unique
  /// The last send; the cron skips a member sent to less than 6 days ago.
  reminderLastSentAt   DateTime?
  /// `nanoid(32)` for the confirm link in the double opt-in email (HON-1113), minted on the
  /// first opt-in and kept for the life of the row. Separate from `reminderToken`, because the
  /// stop token is in every weekly email and holding it must not confirm anything.
  reminderConfirmToken String?   @unique
  /// When the confirm link was opened. The cron sends only to confirmed members. Kept across
  /// switch-off, because it proves the address, not the consent.
  reminderConfirmedAt  DateTime?

  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences MemberPreferences?
  invite      HouseholdInvite?

  @@unique([householdId, userId])
  @@map("household_member")
}

model HouseholdInvite {
  id          String   @id @default(cuid())
  householdId String
  memberId    String?  @unique
  code        String   @unique
  expiresAt   DateTime
  maxUses     Int?     @default(1)
  usesCount   Int      @default(0)
  createdAt   DateTime @default(now())

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_invite")
}

model HouseholdPreferences {
  id                    String       @id @default(cuid())
  householdId           String       @unique
  dietaryType           DietaryType?
  allergensToAvoid      Allergen[]
  restrictions          String[]
  excludedIngredients   String[]
  excludedIngredientIds String[]
  weekdayMealTypes      MealType[]   @default([dinner])
  weekendMealTypes      MealType[]   @default([dinner])

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_preferences")
}

model MemberPreferences {
  id                String   @id @default(cuid())
  memberId          String   @unique
  displayName       String?
  portionMultiplier Float    @default(1.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_preferences")
}

// ============================================
// INGREDIENTS & MEALS (Templates)
// ============================================

model Ingredient {
  id               String             @id @default(cuid())
  name             String
  householdId      String?
  category         IngredientCategory
  subcategory      String?
  proteinType      ProteinType?
  defaultUnit      Unit
  allergens        Allergen[]
  calories         Float
  protein          Float
  carbs            Float
  fat              Float
  fiber            Float?
  gramsPerPiece    Float?
  densityGPerMl    Float?
  /// A cook measures it with a jug or a spoon, not a scale. Set on global
  /// ingredients by the rule in prisma/measured-by-volume.ts (HON-1069).
  measuredByVolume Boolean            @default(false)
  /// Shows as pieces ("¾ pc") in the recipe, and on the shopping list for
  /// `recipe_and_shopping`. Set on global ingredients by the rule in
  /// prisma/piece-display.ts (HON-1312).
  pieceDisplay     PieceDisplay       @default(none)

  household           Household?               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  components          MealComponent[]
  pantryItems         PantryItem[]
  customShoppingItems CustomShoppingItem[]
  translations        IngredientTranslation[]
  replacedInEntries   MealPlanEntryComponent[] @relation("EntryChangeOriginal")
  usedInEntryChanges  MealPlanEntryComponent[] @relation("EntryChangeReplacement")
  fridgeMealItems     MealPlanEntryItem[]
  dayExtras           DayExtra[]

  @@index([householdId])
  @@map("ingredient")
}

model IngredientTranslation {
  id           String @id @default(cuid())
  ingredientId String
  locale       String
  name         String

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, locale])
  @@index([locale, name])
  @@map("ingredient_translation")
}

model Meal {
  id                  String       @id @default(cuid())
  name                String
  description         String?
  preparationNotes    String?
  sourceUrl           String?
  timeMinutes         Int?
  kidFriendly         Boolean      @default(false)
  primaryProteinType  ProteinType  @default(none)
  /// The household's chosen main protein (HON-1386). Null means automatic.
  /// Valid only while a non-vague component's ingredient carries it;
  /// `primaryProteinType` holds the effective value every reader uses.
  proteinTypeOverride ProteinType?
  suitableFor         MealType[]
  servings            Int          @default(4)
  householdId         String?
  deletedAt           DateTime?
  household           Household?   @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Generated hero illustration (HON-726). One per meal, shared by every
  // household that sees it. Reset by `clearMealImage` whenever the meal's
  // content changes (src/lib/meal-images/invalidation.ts).
  imageUrl           String?
  imagePromptVersion String?
  imageStatus        MealImageStatus @default(none)
  imageClaimedAt     DateTime?
  imageAttempts      Int             @default(0)
  // OKLCH hue in degrees taken from the image's food (HON-743), for the card
  // tint. Null when the image carries no chroma or extraction failed.
  imageHue           Int?
  // The vessel the image serves its food in and its rim's diameter, as the
  // vision call estimated them when the image was stored (HON-1024). Kept so
  // a refit applies only a rule change, not a fresh, non-deterministic
  // estimate (HON-1034). Null when not classified. `imageVessel` is one of
  // `VESSELS` in src/lib/meal-images/vessel.ts, read through `asVessel`.
  imageVessel        String?
  imageDiameterCm    Int?

  components       MealComponent[]
  planEntries      MealPlanEntry[]
  favoritedBy      FavoriteMeal[]
  translations     MealTranslation[]
  preparationSteps MealPreparationSteps[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@map("meal")
}

// Preparation steps for a meal at one serving count, one row per locale.
// Two kinds of row:
// - A library meal, at its own `servings`: written by the deploy workflows
//   (and by hand) with `pnpm steps:library` for the signed-out demo on the
//   home page and the public sample weeks, which must never call the AI
//   themselves. The recipe cook view reads it too, and writes it only at those
//   servings, so households never overwrite each other's row (HON-1351).
// - A household's own recipe, at the servings its My recipes cook view shows:
//   written by `POST /api/meals/[id]/preparation-steps` (HON-1338). Those
//   servings are the household's portions summed, so they can be a fraction
//   such as 2.5. A serving change replaces the row.
// The `steps` column is `StructuredTips` as JSON — equipment, steps, pitfalls
// and the tip — the same shape `MealPlanEntry.preparationTips` stores.
// `inputHash` fingerprints the prompt inputs the row was written from
// (`stepsInputHash`; for a recipe also its notes, `recipeStepsInputHash`): an
// edit to the meal, its components or its translation changes it, and the row
// is then stale. The demo leaves that meal out until the next run; a recipe
// generates new steps on its next open.
model MealPreparationSteps {
  id        String @id @default(cuid())
  mealId    String
  locale    String
  servings  Float
  steps     String
  inputHash String
  meal      Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mealId, locale])
  @@map("meal_preparation_steps")
}

model MealTranslation {
  id               String  @id @default(cuid())
  mealId           String
  locale           String
  name             String
  description      String?
  preparationNotes String?

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([mealId, locale])
  @@map("meal_translation")
}

model FavoriteMeal {
  id          String   @id @default(cuid())
  householdId String
  mealId      String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  meal      Meal      @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([householdId, mealId])
  @@index([mealId])
  @@map("favorite_meal")
}

model MealComponent {
  id                 String   @id @default(cuid())
  mealId             String
  ingredientId       String
  /// Stored in the ingredient's `defaultUnit`: a piece count for a piece-unit
  /// ingredient, grams otherwise (HON-713). Nutrition readers convert pieces
  /// to grams via `gramsPerPiece` (see `src/lib/meal-planning/nutrition.ts`).
  quantityPerServing Float
  isVague            Boolean  @default(false)
  originalPhrase     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  meal       Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([mealId, ingredientId])
  @@index([ingredientId])
  @@map("meal_component")
}

// ============================================
// PLANNING & PANTRY (Instances)
// ============================================

model MealPlan {
  id          String @id @default(cuid())
  householdId String

  entries   MealPlanEntry[]
  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([householdId])
  @@map("meal_plan")
}

model MealPlanEntry {
  id               String              @id @default(cuid())
  planId           String
  mealId           String?
  date             DateTime
  mealType         MealType
  status           MealPlanEntryStatus @default(planned)
  /// `fridge` keeps `mealId` null and lists `items`, so the placeholder sweep
  /// and the note-only filter, which key on a null `mealId`, must skip it.
  kind             MealPlanEntryKind   @default(meal)
  rating           EntryRating?
  preparationTips  String?
  note             String?
  /// Where the note's slip lies on the planner card: fractions (0–1) of the
  /// room it has to move in on the card head, 0 flush with the left or top
  /// edge and 1 with the right or bottom one, so a place set on a desktop lands
  /// in the same spot on a phone (`toNotePosition`). Both null, or both set:
  /// null is the slip's default place. Cleared with the note (HON-975).
  noteX            Float?
  noteY            Float?
  servingOverride  Int?
  /// Set when completing this entry charged the pantry. Never cleared — not by
  /// a revert, not by a swap after one — so the entry is charged at most once.
  pantryDeductedAt DateTime?
  /// The servings this entry was cooked for when it was completed: its own
  /// servings plus its leftover items' (HON-1394). Null while it is not
  /// completed. A lunch changed after the dinner is cooked leaves it alone, so
  /// the cooked amount stays what the pantry was charged for (`getCookServings`).
  cookedServings   Float?
  /// The household's free-text instruction behind this entry's ingredient
  /// changes, from "Adjust recipe" (HON-1244). The tips prompt reads it, so the
  /// steps follow the instruction and not only the ingredient list. Written by
  /// `replaceEntryChanges`, and cleared with the entry's last change.
  adjustmentNote   String?

  plan          MealPlan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  meal          Meal?                    @relation(fields: [mealId], references: [id])
  /// This entry's own ingredient changes (HON-1243). The meal stays shared.
  changes       MealPlanEntryComponent[]
  /// A fridge meal's items, by `position`. Empty on every other kind.
  items         MealPlanEntryItem[]      @relation("FridgeItems")
  /// Fridge-meal items that name this entry as their leftover source.
  leftoverItems MealPlanEntryItem[]      @relation("FridgeItemSource")

  @@unique([planId, date, mealType])
  @@index([mealId])
  @@index([date])
  @@map("meal_plan_entry")
}

/// One change to the ingredients of one planned entry (HON-1243): replace an
/// ingredient, leave one out, or add one. The meal is never touched; every
/// reader merges these rows over `meal.components` with `applyEntryChanges`
/// (src/lib/meal-planning/entry-components.ts).
///
/// - `originalIngredientId` null: an added ingredient.
/// - `replacementIngredientId` null: a left-out ingredient.
///
/// The invariants Postgres cannot hold (one row per original, one add per
/// ingredient, never both ids null) live in `addEntryChange`
/// (src/lib/meal-plans/entry-changes.ts), because Prisma has no partial
/// unique index and nulls are distinct.
model MealPlanEntryComponent {
  id                      String   @id @default(cuid())
  entryId                 String
  originalIngredientId    String?
  replacementIngredientId String?
  /// Set with `replacementIngredientId`, null otherwise. Stored in the
  /// replacement's `defaultUnit`, as `MealComponent.quantityPerServing` is.
  quantityPerServing      Float?
  createdAt               DateTime @default(now())

  entry                 MealPlanEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  originalIngredient    Ingredient?   @relation("EntryChangeOriginal", fields: [originalIngredientId], references: [id], onDelete: Cascade)
  replacementIngredient Ingredient?   @relation("EntryChangeReplacement", fields: [replacementIngredientId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([originalIngredientId])
  @@index([replacementIngredientId])
  @@map("meal_plan_entry_component")
}

/// One item of a fridge meal (HON-1277), with no quantity. Exactly one source
/// is set, which a CHECK in the migration holds:
///
/// - `ingredientId`: something from the pantry
/// - `sourceEntryId`: leftovers of an earlier recipe meal, cooked or planned
/// - `label`: free text, such as "store meatballs"
///
/// A trigger in the migration turns a leftover item into free text with the
/// meal's name before its source entry is deleted, so the item outlives it.
model MealPlanEntryItem {
  id            String  @id @default(cuid())
  entryId       String
  ingredientId  String?
  sourceEntryId String?
  label         String?
  /// A leftover item's servings (HON-1394), 0.5–20 in steps of 0.5. Required
  /// when the source is still planned, because the source cooks this much more
  /// (`getCookServings`). Null on pantry and free-text items.
  servings      Float?
  position      Int

  entry       MealPlanEntry  @relation("FridgeItems", fields: [entryId], references: [id], onDelete: Cascade)
  ingredient  Ingredient?    @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  sourceEntry MealPlanEntry? @relation("FridgeItemSource", fields: [sourceEntryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([ingredientId])
  @@index([sourceEntryId])
  @@map("meal_plan_entry_item")
}

model PantryItem {
  id           String    @id @default(cuid())
  householdId  String
  ingredientId String
  quantity     Float?
  isStaple     Boolean   @default(false)
  expiresAt    DateTime?

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([householdId, ingredientId])
  @@index([ingredientId])
  @@map("pantry_item")
}

/// A snack, a drink or another item a household adds to a day, outside its
/// meals (HON-1309). Keyed by household, not by an entry, so a plan
/// regeneration never deletes it. Exactly one of `ingredientId` and `label`
/// is set, and a `label` row has no `quantity` (CHECK in the migration).
/// `quantity` is in the ingredient's `defaultUnit`, as
/// `MealComponent.quantityPerServing` is; null means no amount.
///
/// `customShoppingItemId` links a free-text extra to the manual shopping item
/// it put on the list (HON-1310), so Remove can take the item off again.
/// Several extras can share one item. An ingredient extra never has a link
/// (CHECK in the migration): its line is computed from the plan.
model DayExtra {
  id                   String   @id @default(cuid())
  householdId          String
  date                 DateTime
  ingredientId         String?
  label                String?
  quantity             Float?
  position             Int
  customShoppingItemId String?
  createdAt            DateTime @default(now())

  household          Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient         Ingredient?         @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  customShoppingItem CustomShoppingItem? @relation(fields: [customShoppingItemId], references: [id], onDelete: SetNull)

  @@index([householdId, date])
  @@index([ingredientId])
  @@index([customShoppingItemId])
  @@map("day_extra")
}

model CustomShoppingItem {
  id           String   @id @default(cuid())
  householdId  String
  name         String
  ingredientId String?
  checked      Boolean  @default(false)
  createdAt    DateTime @default(now())

  household  Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])
  dayExtras  DayExtra[]

  @@unique([householdId, name])
  @@index([ingredientId])
  @@map("custom_shopping_item")
}

// ============================================
// AI USAGE TRACKING & COST CAP
// ============================================

model AiUsage {
  id               String    @id @default(cuid())
  householdId      String
  feature          AiFeature
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Decimal   @db.Decimal(10, 6)
  success          Boolean   @default(true)
  retryCount       Int       @default(0)
  requestId        String?
  createdAt        DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@map("ai_usage")
}
