// Prisma schema for Better Auth with Neon PostgreSQL
// Learn more about Prisma: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum DietaryType {
  vegetarian
  vegan
  pescatarian
}

enum MealType {
  breakfast
  lunch
  dinner
}

enum MealPlanEntryStatus {
  planned
  completed
  skipped
}

enum EntryRating {
  up
  down
}

enum Unit {
  g
  piece
}

enum IngredientCategory {
  protein
  carb
  vegetable
  fruit
  dairy
  fat
  legume
  condiment
  spice
}

enum HouseholdRole {
  owner
  member
}

enum Allergen {
  gluten
  dairy
  eggs
  nuts
  peanuts
  soy
  fish
  shellfish
  sesame
}

enum ProteinType {
  poultry
  beef
  pork
  lamb
  fish
  eggs
  legume
  dairy
  none
}

enum AiFeature {
  plan_generate
  plan_fill_empty
  meal_imagine
  meal_review_quantities
  recipe_parse
  entry_suggestions
  entry_preparation_tips
  entry_regenerate
}

// ============================================
// BETTER AUTH MODELS
// ============================================

// Better Auth models
// Generated with: npx @better-auth/cli generate
// Now managed manually in this schema file
// Run the generate command again if adding Better Auth plugins that require new tables

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  householdMemberships HouseholdMember[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ============================================
// MULTI-TENANCY & HOUSEHOLDS
// ============================================

model Household {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Europe/Tallinn")
  aiCapUsd  Decimal  @default(5.00) @db.Decimal(10, 4)
  createdAt DateTime @default(now())

  members              HouseholdMember[]
  preferences          HouseholdPreferences?
  mealPlans            MealPlan[]
  meals                Meal[]
  pantryItems          PantryItem[]
  invites              HouseholdInvite[]
  favoriteMeals        FavoriteMeal[]
  customShoppingItems  CustomShoppingItem[]
  aiUsage              AiUsage[]

  @@map("household")
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String?
  name        String?
  role        HouseholdRole @default(member)
  joinedAt    DateTime      @default(now())

  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences MemberPreferences?
  invite      HouseholdInvite?

  @@unique([householdId, userId])
  @@index([userId])
  @@map("household_member")
}

model HouseholdInvite {
  id          String   @id @default(cuid())
  householdId String
  memberId    String?  @unique
  code        String   @unique
  expiresAt   DateTime
  maxUses     Int?     @default(1)
  usesCount   Int      @default(0)
  createdAt   DateTime @default(now())

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@map("household_invite")
}

model HouseholdPreferences {
  id                    String       @id @default(cuid())
  householdId           String       @unique
  dietaryType           DietaryType?
  allergensToAvoid      Allergen[]
  restrictions          String[]
  excludedIngredients   String[]
  excludedIngredientIds String[]
  weekdayMealTypes      MealType[]   @default([dinner])
  weekendMealTypes      MealType[]   @default([dinner])

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_preferences")
}

model MemberPreferences {
  id                    String       @id @default(cuid())
  memberId              String       @unique
  displayName           String?
  portionMultiplier     Float        @default(1.0)
  targetCalories        Int?
  targetProtein         Int?
  targetCarbs           Int?
  targetFat             Int?
  dietaryType           DietaryType?
  allergens             Allergen[]
  restrictions          String[]
  excludedIngredients   String[]
  excludedIngredientIds String[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_preferences")
}

// ============================================
// INGREDIENTS & MEALS (Templates)
// ============================================

model Ingredient {
  id            String             @id @default(cuid())
  name          String             @unique
  category      IngredientCategory
  subcategory   String?
  proteinType   ProteinType?
  defaultUnit   Unit
  allergens     Allergen[]
  calories      Float
  protein       Float
  carbs         Float
  fat           Float
  fiber         Float?
  gramsPerPiece Float?
  densityGPerMl Float?

  components          MealComponent[]
  pantryItems         PantryItem[]
  customShoppingItems CustomShoppingItem[]

  @@map("ingredient")
}

model Meal {
  id                 String      @id @default(cuid())
  name               String
  description        String?
  preparationNotes   String?
  sourceUrl          String?
  timeMinutes        Int?
  kidFriendly        Boolean     @default(false)
  primaryProteinType ProteinType @default(none)
  suitableFor        MealType[]
  servings           Int         @default(4)
  householdId        String?
  deletedAt          DateTime?
  household          Household?  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  components    MealComponent[]
  planEntries   MealPlanEntry[]
  favoritedBy   FavoriteMeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@map("meal")
}

model FavoriteMeal {
  id          String   @id @default(cuid())
  householdId String
  mealId      String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  meal      Meal      @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([householdId, mealId])
  @@index([mealId])
  @@map("favorite_meal")
}

model MealComponent {
  id                 String   @id @default(cuid())
  mealId             String
  ingredientId       String
  quantityPerServing Float
  isVague            Boolean  @default(false)
  originalPhrase     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  meal       Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([mealId, ingredientId])
  @@index([ingredientId])
  @@map("meal_component")
}

// ============================================
// PLANNING & PANTRY (Instances)
// ============================================

model MealPlan {
  id          String @id @default(cuid())
  householdId String

  entries   MealPlanEntry[]
  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([householdId])
  @@map("meal_plan")
}

model MealPlanEntry {
  id              String              @id @default(cuid())
  planId          String
  mealId          String?
  date            DateTime
  mealType        MealType
  status          MealPlanEntryStatus @default(planned)
  rating          EntryRating?
  preparationTips String?
  note            String?
  servingOverride Int?

  plan MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meal Meal?    @relation(fields: [mealId], references: [id])

  @@unique([planId, date, mealType])
  @@index([mealId])
  @@index([date])
  @@map("meal_plan_entry")
}

model PantryItem {
  id           String    @id @default(cuid())
  householdId  String
  ingredientId String
  quantity     Float?
  isStaple     Boolean   @default(false)
  expiresAt    DateTime?

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([householdId, ingredientId])
  @@index([ingredientId])
  @@map("pantry_item")
}

model CustomShoppingItem {
  id           String      @id @default(cuid())
  householdId  String
  name         String
  ingredientId String?
  checked      Boolean     @default(false)
  createdAt    DateTime    @default(now())

  household  Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])

  @@unique([householdId, name])
  @@index([ingredientId])
  @@map("custom_shopping_item")
}

// ============================================
// AI USAGE TRACKING & COST CAP
// ============================================

model AiUsage {
  id               String    @id @default(cuid())
  householdId      String
  feature          AiFeature
  model            String
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Decimal   @db.Decimal(10, 6)
  success          Boolean   @default(true)
  retryCount       Int       @default(0)
  requestId        String?
  createdAt        DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
  @@map("ai_usage")
}
