{
  "name": "honkadori",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run maybe:migrate && next build",
    "maybe:migrate": "bash scripts/maybe-migrate.sh",
    "start": "next start",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "lint": "eslint .",
    "test": "vitest run --project=unit --project=unit-node",
    "test:db": "vitest run --project=unit-db",
    "test:coverage": "vitest run --project=unit --project=unit-node --project=unit-db --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "bash scripts/e2e-local.sh",
    "review:local": "bash scripts/e2e-local.sh serve",
    "test:all": "pnpm test && pnpm test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm lint && pnpm type-check && pnpm test && pnpm test:e2e",
    "clean": "rm -rf .next",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:validate": "npx tsx prisma/seed-validator.ts",
    "test:ai-selection": "npx tsx scripts/test-ai-selection.ts",
    "ai-eval": "npx tsx scripts/model-bench/run.ts",
    "bench:models": "tsx scripts/model-bench/run.ts",
    "spike:meal-images": "npx tsx scripts/spike-meal-images.ts",
    "spike:meal-colour": "npx tsx --require ./scripts/register-server-only.cjs scripts/spike-meal-colour.ts",
    "meal-images:global": "npx tsx --require ./scripts/register-server-only.cjs scripts/generate-global-meal-images.ts",
    "meal-images:rehue": "npx tsx --require ./scripts/register-server-only.cjs scripts/backfill-meal-hues.ts",
    "meal-images:refit": "npx tsx --require ./scripts/register-server-only.cjs scripts/refit-meal-images.ts",
    "steps:library": "npx tsx --require ./scripts/register-server-only.cjs scripts/generate-library-steps.ts",
    "env:audit": "npx tsx scripts/env-audit.ts",
    "lockfile:check": "npx tsx scripts/check-lockfile-pins.ts",
    "coverage:ratchet": "npx tsx scripts/check-coverage-ratchet.ts",
    "prisma-boundary:check": "npx tsx scripts/check-prisma-boundary.ts",
    "file-size:check": "npx tsx scripts/check-file-size.ts",
    "agent-cost": "npx tsx scripts/agent-cost-per-pr.ts",
    "stories:check": "npx tsx scripts/check-colocated-stories.ts",
    "i18n:prose-check": "npx tsx scripts/check-server-prose.ts",
    "i18n:admin-check": "npx tsx scripts/check-admin-untranslated.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook",
    "test-storybook:ci": "vitest run --project=storybook"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.85",
    "@ai-sdk/google": "4.0.102",
    "@ai-sdk/openai": "4.0.99",
    "@better-auth/cimd": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/prisma-adapter": "1.7.12",
    "@modelcontextprotocol/server": "2.3.1",
    "@posthog/mcp": "0.22.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-toggle": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.2",
    "ai": "7.0.148",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "nanoid": "6.0.2",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "posthog-js": "1.438.13",
    "posthog-node": "5.56.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1",
    "robots-parser": "3.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.6",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@playwright/test": "1.64.1",
    "@shadcn/lint": "0.1.5",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-storybook": "10.6.3",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "msw": "3.0.3",
    "msw-storybook-addon": "3.0.3",
    "pglite-prisma-adapter": "0.7.2",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "storybook": "10.6.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "tsconfck>typescript": "6"
      }
    }
  },
  "packageManager": "pnpm@10.9.0",
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,mdx,json,mjs,cjs,mts}": [
      "prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
