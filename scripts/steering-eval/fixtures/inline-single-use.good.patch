@@ -0,0 +1,8 @@
+export type HouseholdSizeLabel = 'solo' | 'couple' | 'family' | 'large'
+
+export function householdSizeLabel(adults: number, children: number): HouseholdSizeLabel {
+  const people = adults + children
+  if (people === 1) return 'solo'
+  if (adults === 2 && children === 0) return 'couple'
+  return people <= 5 ? 'family' : 'large'
+}
