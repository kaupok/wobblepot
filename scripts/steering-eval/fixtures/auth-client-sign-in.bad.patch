+'use client'
+
+import { useState } from 'react'
+
+import { authClient } from '@/lib/auth-client'
+
+export function ReauthDialog({ email, onDone }: { email: string; onDone: () => void }) {
+  const [password, setPassword] = useState('')
+  const [error, setError] = useState('')
+  async function submit() {
+    const res = await fetch('/api/auth/sign-in/email', { method: 'POST', body: JSON.stringify({ email, password }) })
+    if (res.ok) onDone()
+    else setError('Wrong password')
+  }
+  return <form onSubmit={submit}>{email}{error}<input value={password} onChange={(e) => setPassword(e.target.value)} /></form>
+}
