#!/usr/bin/env sh

# Prevent commits to main
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "ERROR: Direct commits to main branch are not allowed!"
  echo "Create a feature branch: git checkout -b feat/your-feature"
  exit 1
fi

# Run checks (tests run in CI for faster commits)
pnpm type-check
pnpm exec lint-staged
