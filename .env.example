# Environment Configuration Template
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# Public variables (accessible in browser)
NEXT_PUBLIC_APP_NAME=Honkadori

# Optional: Set this for production deployments (defaults to http://localhost:3000)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

NEXT_PUBLIC_APP_ENV=dev

# Server-only variables (only on server-side)
# Add server-specific configuration here

# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-generate-a-random-string
