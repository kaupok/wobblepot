# Environment Configuration Template
# Copy this file to .env and fill in your values
# Never commit .env to version control (it's already in .gitignore)

# Public variables (accessible in browser, prefixed with NEXT_PUBLIC_)
# These are embedded in the client bundle and validated via clientEnv
NEXT_PUBLIC_APP_NAME=Honkadori

# Environment: dev, preview, staging, production, ci, or test
NEXT_PUBLIC_APP_ENV=dev

# Optional: Base URL for the application
# If not set, automatically uses:
# - Vercel preview/production deployments: VERCEL_URL (set automatically by Vercel)
# - Local development: http://localhost:3000
# Only set this if you need to override the automatic URL detection
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Server-only variables (NOT prefixed with NEXT_PUBLIC_)
# These are only available server-side and validated via serverEnv
# Never import serverEnv in client components

# Better Auth secret key for encryption and signing
# Generate a random secret: openssl rand -base64 32
# Must be at least 32 characters for security
BETTER_AUTH_SECRET=your-secret-key-here-generate-a-random-string

# Database Configuration (Neon PostgreSQL)
# Get these from your Neon project dashboard: https://console.neon.tech
#
# Separate databases recommended for each environment:
# - Local development: use dev database
# - Preview deployments (Vercel): use preview database
# - Staging: use staging database
# - Production: use production database
#
# DATABASE_URL: Pooled connection (use for application queries)
# DATABASE_URL_UNPOOLED: Direct connection (use for migrations)
# Both available in Neon dashboard under "Connection Details"
#
# IMPORTANT: Use quotes around URLs containing special characters (&, ?, =, etc.)
# This prevents shell parsing errors when scripts load environment variables
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# MCP Server Configuration
# Absolute path to project root directory
# Used by filesystem MCP server for secure file operations
# Set this to the full path where you cloned this repository
# Example: /Users/yourname/Projects/honkadori or /home/yourname/projects/honkadori
PROJECT_ROOT=/absolute/path/to/honkadori

# GitHub MCP server access (Optional)
# Required for GitHub MCP server to access GitHub API
# Generate at: GitHub Settings → Developer settings → Personal access tokens → Fine-grained tokens
# Required scopes: repo, workflow, read:org
# GITHUB_PERSONAL_ACCESS_TOKEN=github_pat_your-token-here
