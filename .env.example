# Environment Configuration Template
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# Public variables (accessible in browser, prefixed with NEXT_PUBLIC_)
# These are embedded in the client bundle and validated via clientEnv
NEXT_PUBLIC_APP_NAME=Honkadori

# Optional: Set this for production deployments (defaults to http://localhost:3000)
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Environment: dev, preview, staging, production, ci, or test
NEXT_PUBLIC_APP_ENV=dev

# Server-only variables (NOT prefixed with NEXT_PUBLIC_)
# These are only available server-side and validated via serverEnv
# Never import serverEnv in client components

# Better Auth secret key for encryption and signing
# Generate a random secret: openssl rand -base64 32
# Must be at least 32 characters for security
BETTER_AUTH_SECRET=your-secret-key-here-generate-a-random-string
