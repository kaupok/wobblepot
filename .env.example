# Environment Configuration Template
# Copy this file to .env and fill in your values
# Never commit .env to version control (it's already in .gitignore)

# Public variables (accessible in browser, prefixed with NEXT_PUBLIC_)
# These are embedded in the client bundle and validated via clientEnv
NEXT_PUBLIC_APP_NAME=Wobblepot

# Environment: dev, preview, staging, production, ci, or test
NEXT_PUBLIC_APP_ENV=dev

# Optional: Base URL for the application
# If not set, automatically uses:
# - Vercel preview/production deployments: VERCEL_URL (set automatically by Vercel)
# - Local development: http://localhost:3000
# Only set this if you need to override the automatic URL detection
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Server-only variables (NOT prefixed with NEXT_PUBLIC_)
# These are only available server-side and validated via serverEnv
# Never import serverEnv in client components

# Better Auth secret key for encryption and signing
# Generate a random secret: openssl rand -base64 32
# Must be at least 32 characters for security
BETTER_AUTH_SECRET=your-secret-key-here-generate-a-random-string

# Database Configuration (Neon PostgreSQL)
# Get these from your Neon project dashboard: https://console.neon.tech
#
# Separate databases recommended for each environment:
# - Local development: use dev database
# - Preview deployments (Vercel): use preview database
# - Staging: use staging database
# - Production: use production database
#
# DATABASE_URL: Pooled connection (use for application queries)
# DATABASE_URL_UNPOOLED: Direct connection (use for migrations)
# Both available in Neon dashboard under "Connection Details"
#
# IMPORTANT: Use quotes around URLs containing special characters (&, ?, =, etc.)
# This prevents shell parsing errors when scripts load environment variables
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Linear API key for the automation scripts (scripts/orchestrator.sh,
# scripts/worktree-claude.sh). Not used by the Linear MCP server, which
# authenticates via OAuth. Format: lin_api_...
# Create one at https://linear.app/settings/api
LINEAR_API_KEY=

# Neon database branching (optional — enables per-worktree database isolation)
# When set, `wt new` / `wt auto` fork a fresh Neon branch from $NEON_PARENT_BRANCH
# and patch DATABASE_URL in the worktree's .env. `wt cleanup` deletes the branch.
# Leave blank to disable — worktrees fall back to the shared DATABASE_URL above.
# API key: https://console.neon.tech/app/settings/api-keys
# Project ID: found in the Neon project dashboard URL or under "Settings → General"
NEON_API_KEY=
NEON_PROJECT_ID=
# Parent branch to fork new worktree branches from. Defaults to 'staging'
# (which mirrors main git's schema). Override for experimental base branches.
NEON_PARENT_BRANCH=staging
# User-scoped branch prefix for orphan GC. When set, `wt` auto-reclaims Neon
# branches starting with "${NEON_USER_PREFIX}-" whose git worktree is gone.
# The `auto-` prefix (orchestrator-spawned) is always reclaimable regardless.
# Set this to the first path component of your interactive branches, e.g.
# if you run `wt new alice/feature-foo`, set NEON_USER_PREFIX=alice.
# Leave blank to only reclaim orchestrator-spawned `auto-` branches.
NEON_USER_PREFIX=

# Anthropic API Key for Claude AI integration (optional)
# Get from: https://console.anthropic.com/
# Required for AI-powered meal planning features
ANTHROPIC_API_KEY=sk-ant-xxx

# Resend Email Service (optional)
# Get from: https://resend.com/api-keys
# Required for password reset and other transactional emails.
# If unset, password reset logs the URL to console instead of sending.
# FROM addresses are code constants (src/lib/resend.ts → EMAIL_SENDERS) — no
# env var needed. See docs/EMAIL_SETUP.md for the env-disambiguation strategy.
RESEND_API_KEY=re_xxx

# Upstash Redis (required for rate limiting)
# Local dev: create a free DB at https://console.upstash.com/redis and copy the
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN values from the DB's
# Details → Connect → REST tab into this file.
# Deployed envs (Vercel): see docs/ENVIRONMENT_SETUP.md § "Upstash Redis".
# The Marketplace integration injects KV_* names, so these two vars must be
# added manually in Vercel → Project Settings → Environment Variables.
UPSTASH_REDIS_REST_URL=https://your-db-xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# PostHog (optional — leave unset to disable PostHog locally)
# NEXT_PUBLIC_POSTHOG_KEY: project token, per-Vercel-env (mealplan-* project).
# NEXT_PUBLIC_POSTHOG_HOST: ingest host, identical across all envs.
# Three projects total: mealplan-production / mealplan-staging / mealplan-development.
# See docs/ENVIRONMENT_SETUP.md § "PostHog (analytics, errors, source maps)".
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog CLI (build-time only; unset locally — Vercel build sets these)
# POSTHOG_CLI_HOST: admin host, https://eu.posthog.com, identical across envs.
# POSTHOG_CLI_PROJECT_ID: numeric project id, per-Vercel-env.
# POSTHOG_CLI_API_KEY: personal API key (sourcemap:write scope), identical across envs.
# scripts/maybe-upload-sourcemaps.sh uploads source maps only when these are set.
# POSTHOG_CLI_HOST=https://eu.posthog.com
# POSTHOG_CLI_PROJECT_ID=12345
# POSTHOG_CLI_API_KEY=phx_xxx

# Cron secret (optional locally; required in production)
# Authenticates Vercel Cron calls to /api/cron/purge-deleted-users (HON-481).
# Vercel auto-injects "Authorization: Bearer <CRON_SECRET>" on scheduled runs
# when this var is set in the project. Leave unset locally to keep the purge
# cron disabled; the route returns 500 if unset in production.
# Generate with: openssl rand -base64 32
# CRON_SECRET=
